{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "sandbox": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENV": "sandbox"
      }
    },
    "preview": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENV": "sandbox"
      }
    },
    "sit": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENV": "sit"
      }
    },
    "uat": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_ENV": "uat"
      }
    },
    "preview-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      },
      "distribution": "internal",
      "autoIncrement": false
    }
  },
  "submit": {
    "preview": {
      "ios": {}
    },
    "sit": {
      "ios": {}
    },
    "uat": {
      "ios": {}
    }
  }
}
