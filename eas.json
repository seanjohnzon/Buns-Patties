{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "remote" },
  "build": {
    "sandbox": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_ENV": "sandbox" }
    },
    "sit": {
      "distribution": "internal",
      "ios": { "simulator": false },
      "env": { "EXPO_PUBLIC_ENV": "sit" },
      "channel": "sit"
    },
    "uat": {
      "distribution": "store",
      "env": { "EXPO_PUBLIC_ENV": "uat" },
      "channel": "uat"
    }
  },
  "submit": {
    "uat": {}
  }
}
