ios/
android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# the printed menu is 62MB of scanned artwork; it is reference, not source.
# Keep a copy outside the repo — assets/brand/menu.png is the readable version.
assets/brand/Menu.pdf

