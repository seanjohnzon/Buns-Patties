# The branch decides which database the app talks to — the same values as
# netlify.toml, for the phone build this time.
#
#   test-env   the test project (Supabase "buns-patties-test"), Square sandbox,
#              test sign-in codes (DEPLOY.md, part 1). Nothing real is charged.
#
# A plain clone of this branch builds "B&P Test" against that database: nothing
# to type in. These are public values. Expo writes every EXPO_PUBLIC_ value into
# the app itself, and the key is Supabase's publishable key, which is made to be
# seen. A secret key never goes in this file (tests/security.test.mjs checks).
EXPO_PUBLIC_ENV=sit
EXPO_PUBLIC_SUPABASE_URL=https://ysochqypjpmuhackmzqw.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_zHvThsRMst2Jjk3A2Lsutg_VeEap0h-
