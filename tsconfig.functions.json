{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noImplicitAny": false,
    "paths": { "https://esm.sh/@supabase/supabase-js@2": ["./node_modules/@supabase/supabase-js"] }
  },
  "include": ["supabase/functions/**/*.ts"]
}
