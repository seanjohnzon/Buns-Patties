# Copy to .env — Expo reads EXPO_PUBLIC_* at build time.
#
# Two environments, two Supabase projects, two Stripe key pairs:
#   Sandbox — Expo Go, local. Supabase test OTP for sign-in, Stripe test keys.
#   SIT     — TestFlight. Twilio sends real codes, Stripe still in test mode.
# Live Stripe keys are only used at release, never in either test environment.
# Where the web version is served from. Stripe sends customers back here after
# paying, so it must match the real address exactly.
EXPO_PUBLIC_SITE_URL=https://order.bunsandpatties.com

EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
EXPO_PUBLIC_APP_STORE_URL=
EXPO_PUBLIC_PLAY_STORE_URL=

# The Buns & Patties Google listing (CID 559877457463287649).
# This opens the listing, where "Write a review" is one tap. Swap it for the
# official short link once the owner grabs it from their Google Business Profile
# ("Ask for reviews" gives a https://g.page/r/.../review link that opens the
# review box directly).
EXPO_PUBLIC_GOOGLE_REVIEW_URL=https://maps.google.com/?cid=559877457463287649

# Sandbox only: pretend to be a customer or staff member to check the role gates.
# Leave unset — demo mode signs you in as the owner.
# EXPO_PUBLIC_DEMO_ROLE=customer
