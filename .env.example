# Copy to .env — Expo reads EXPO_PUBLIC_* at build time.
#
# Three environments, one Supabase project each:
#   Sandbox — Expo Go, dummy data. Supabase test OTP for sign-in, card payments in test mode.
#   SIT     — TestFlight, throwaway data. Twilio sends real codes, payments still in test mode.
#   UAT     — real customers at the truck. Live payments, a database that is never wiped.
# Card payments: Square (the owner's existing account) — the app code still has the
# Stripe version until the swap lands; see OPERATIONS.md.

# Where the web version is served from. The payment page sends customers back
# here, so it must match the real address exactly.
EXPO_PUBLIC_SITE_URL=https://bunsandpattieshtx.com

EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
EXPO_PUBLIC_APP_STORE_URL=
EXPO_PUBLIC_PLAY_STORE_URL=

# Sandbox only: pretend to be a customer or staff member to check the role gates.
# Leave unset — demo mode signs you in as the owner.
# EXPO_PUBLIC_DEMO_ROLE=customer
